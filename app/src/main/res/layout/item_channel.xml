<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    
    <data>
        <variable
            name="catId"
            type="int" />
        <variable
            name="chId"
            type="int" />
        <variable
            name="modelChannel"
            type="net.harimurti.tv.model.Channel" />
        <variable
            name="clickListener"
            type="net.harimurti.tv.adapter.ChannelClickListener" />
    </data>
    
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        app:cardBackgroundColor="#2A2A2A"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        android:focusable="true"
        android:onClick="@{() -> clickListener.onClicked(modelChannel, catId, chId)}"
        android:onLongClick="@{() -> clickListener.onLongClicked(modelChannel, catId, chId)}"
        android:onFocusChange="@{(v, hasFocus) -> clickListener.onFocusChanged(v, hasFocus)}">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">

            <!-- Container Logo dengan ukuran tetap -->
            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:id="@+id/iv_channel_logo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:padding="4dp"
                    tools:src="@drawable/ic_default_logo" />

            </FrameLayout>

            <!-- Nama Channel -->
            <TextView
                android:id="@+id/tv_channel_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@{modelChannel.name}"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:gravity="center"
                tools:text="RCTI" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>
</layout>