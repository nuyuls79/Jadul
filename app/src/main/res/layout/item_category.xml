<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <variable
            name="catModel"
            type="net.harimurti.tv.model.Category" />
        <variable
            name="channelCount"
            type="int" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/text_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:padding="12dp"
            android:text="@{catModel.name}"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:background="@drawable/bg_category_item_transparent"
            tools:background="@drawable/bg_category_item_transparent"
            tools:text="EVENT 027/FEBRUARI/2026" />

        <!-- Counter jumlah channel, hanya muncul jika > 0 -->
        <TextView
            android:id="@+id/tv_channel_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:text="@{String.valueOf(channelCount)}"
            android:textSize="11sp"
            android:textColor="#E91E63"
            android:textStyle="bold"
            android:padding="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:visibility="@{channelCount > 0 ? View.VISIBLE : View.GONE}"
            tools:text="5"
            tools:visibility="visible" />

    </FrameLayout>
</layout>