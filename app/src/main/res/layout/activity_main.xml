<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    
    <data>
        <variable name="catAdapter" type="net.harimurti.tv.adapter.CategoryAdapter" />
    </data>
    
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#121212">

        <!-- Tombol atas - lebih kecil & rapat -->
        <LinearLayout
            android:id="@+id/layout_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp"
            android:elevation="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            
            <ImageButton
                android:id="@+id/button_search"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                app:srcCompat="@drawable/ic_search" />
            <ImageButton
                android:id="@+id/button_refresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                app:srcCompat="@drawable/ic_refresh" />
            <ImageButton
                android:id="@+id/button_settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/exo_ic_settings" />
            <ImageButton
                android:id="@+id/button_exit"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                app:srcCompat="@drawable/ic_exit" />
        </LinearLayout>

        <!-- SIDEBAR KATEGORI - LANGSUNG DI BAWAH BUTTON (TANPA MARGIN) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_category"
            android:layout_width="180dp"
            android:layout_height="0dp"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="4dp"
            android:layout_marginStart="4dp"
            android:orientation="vertical"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_buttons"
            android:adapter="@{catAdapter}"
            android:background="#1E1E1E"
            android:overScrollMode="never"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />

        <!-- GRID CHANNEL - LANGSUNG DI BAWAH BUTTON (TANPA MARGIN) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_channels"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            android:clipToPadding="false"
            android:padding="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/rv_category"
            app:layout_constraintTop_toBottomOf="@id/layout_buttons"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="4" />

        <!-- Loading Shimmer -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/loading"
            android:layout_width="180dp"   <!-- Lebar sama dengan sidebar -->
            android:layout_height="0dp"     <!-- Tinggi mengikuti constraint -->
            android:layout_marginTop="60dp"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:shimmer_auto_start="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_buttons">
        
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
        
                <!-- Ulangi dummy sebanyak perkiraan jumlah kategori -->
                <include layout="@layout/item_category_dummy" />
                <include layout="@layout/item_category_dummy" />
                <include layout="@layout/item_category_dummy" />
                <include layout="@layout/item_category_dummy" />
                <include layout="@layout/item_category_dummy" />
                <include layout="@layout/item_category_dummy" />
                <include layout="@layout/item_category_dummy" />
                <include layout="@layout/item_category_dummy" />
                <include layout="@layout/item_category_dummy" />
                <include layout="@layout/item_category_dummy" />
            </LinearLayout>

</com.facebook.shimmer.ShimmerFrameLayout>
        
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>